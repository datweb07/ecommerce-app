# Dashboard worksheet. Copy entries only to the indicated service.
# Replace placeholders with values from your dashboards. Keep secret values out of Git.

# Render only. NODE_ENV/HOST/DEPLOY_ENV are supplied by the image/Blueprint.
# PORT is supplied by Render. WEB_ORIGIN is the canonical Clerk/Stripe return origin.
WEB_ORIGIN=https://<project>.vercel.app
# Exact HTTPS origins, comma-separated. Start with the stable staging web URL.
CORS_ORIGINS=https://<project>.vercel.app
# Atlas SRV URI with /web_staging and an account scoped to that database.
MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ADMIN_EMAIL=
# Stripe dashboard Test mode keys for the web Stripe account.
STRIPE_SECRET_KEY=
# Hosted test endpoint signing secret. Use stripe listen only for local.
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: tune after checking proxy and Atlas behavior.
TRUST_PROXY_HOPS=1
MONGO_MAX_POOL_SIZE=20
LOG_LEVEL=info
SHIPPING_FEE_CENTS=1000
TAX_RATE=0.08
ADMIN_LOW_STOCK=5
ADMIN_BANNER_MAX_COUNT=10
ADMIN_PRODUCT_MAX_IMAGES=5
ADMIN_IMAGE_MAX_BYTES=5242880
ADDRESS_MAX_COUNT=10

# Vercel only. Assign to Production slot of the STAGING project.
DEPLOY_ENV=staging
NEXT_PUBLIC_SITE_URL=https://<project>.vercel.app
NEXT_PUBLIC_API_URL=https://<service>.onrender.com
API_INTERNAL_URL=https://<service>.onrender.com
CLOUDINARY_IMAGE_CLOUD_NAME=
# Same DEVELOPMENT instance as Render. Add its CLERK_SECRET_KEY to Vercel too.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
WEB_HSTS_MAX_AGE=300
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_MASCOT_ENABLED=true
NEXT_PUBLIC_GLOBE_ENABLED=true
NEXT_PUBLIC_STORE_CONTACT_EMAIL=
# Optional approved HTTPS Android release link.
MOBILE_ANDROID_DOWNLOAD_URL=

# Both dashboards. Keep pricing and cart settings aligned.
CURRENCY=usd
CART_MAX_QUANTITY=25
