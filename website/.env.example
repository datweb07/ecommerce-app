# Copy to website/.env yourself. Never commit real .env files or print keys.
# Phase 1 needs no external service credentials. API loads only website/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Dedicated LOCAL web database, not the legacy/mobile production database.
MONGODB_URI=mongodb://127.0.0.1:27018/storefront_web?replicaSet=rs0&directConnection=true
# Exact origins, comma separated; no wildcard. Browser sends Bearer tokens later.
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Price policy. Keep USD while sharing legacy major-unit product prices.
CURRENCY=usd
SHIPPING_FEE_CENTS=1000
TAX_RATE=0.08
# Phase 2: SAME Clerk application as mobile. Dashboard > API keys / Webhooks.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Verified admin identity; no admin role is trusted from browser input.
ADMIN_EMAIL=
# Phase 2: SEPARATE web Stripe account, TEST MODE ONLY (sk_test_...).
STRIPE_SECRET_KEY=
# Local stripe listen signing secret, separate from Dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=
# Phase 2: Cloudinary product upload signing (server only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OPTIONAL product import source: use a Mongo user with read-only permissions.
# Script reads only products; target always restricted to local storefront_web.
LEGACY_PRODUCTS_URI=
