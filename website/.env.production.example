# Dashboard worksheet for restricted catalogue review. Keep values out of Git.
# DOMAIN is a DNS zone you control. Review the launch gates before copying anything.

# Render only. NODE_ENV/HOST/DEPLOY_ENV are supplied by the image/Blueprint.
# PORT is supplied by Render. Set exactly one browser origin for production.
WEB_ORIGIN=https://www.<DOMAIN>
CORS_ORIGINS=https://www.<DOMAIN>
# Atlas SRV URI with /web_prod, scoped runtime user, TLS and majority.
MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Omit STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET. Live checkout is gated.
TRUST_PROXY_HOPS=1
MONGO_MAX_POOL_SIZE=20
LOG_LEVEL=info
SHIPPING_FEE_CENTS=1000
TAX_RATE=0.08
ADMIN_LOW_STOCK=5
ADMIN_BANNER_MAX_COUNT=10
ADMIN_PRODUCT_MAX_IMAGES=5
ADMIN_IMAGE_MAX_BYTES=5242880
ADDRESS_MAX_COUNT=10

# Vercel only. Assign to Production slot of the PRODUCTION project.
DEPLOY_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.<DOMAIN>
NEXT_PUBLIC_API_URL=https://api.<DOMAIN>
API_INTERNAL_URL=https://api.<DOMAIN>
CLOUDINARY_IMAGE_CLOUD_NAME=
# Same PRODUCTION instance as Render. Add its CLERK_SECRET_KEY to Vercel too.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
WEB_HSTS_MAX_AGE=300
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_MASCOT_ENABLED=true
NEXT_PUBLIC_GLOBE_ENABLED=true
NEXT_PUBLIC_STORE_CONTACT_EMAIL=
MOBILE_ANDROID_DOWNLOAD_URL=

# Both dashboards.
CURRENCY=usd
CART_MAX_QUANTITY=25
