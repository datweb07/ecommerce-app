# Copy to apps/web/.env.local yourself when phase 2/3 needs external credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Same Clerk application as mobile; publishable key only in NEXT_PUBLIC variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only, never prefix with NEXT_PUBLIC_. Needed for Clerk integration later.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
