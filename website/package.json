{
  "name": "@storefront/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node scripts/pnpm.mjs --filter @storefront/shared build && node scripts/dev.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node scripts/pnpm.mjs --filter @storefront/shared build && node scripts/pnpm.mjs --workspace-concurrency=1 -r typecheck && tsc -p tsconfig.tools.json",
    "test": "node scripts/pnpm.mjs --filter @storefront/shared build && vitest run",
    "e2e": "node scripts/pnpm.mjs --filter @storefront/web e2e all",
    "e2e:public": "node scripts/pnpm.mjs --filter @storefront/web e2e public",
    "e2e:auth": "node scripts/pnpm.mjs --filter @storefront/web e2e auth",
    "e2e:payment": "node scripts/pnpm.mjs --filter @storefront/web e2e payment",
    "e2e:upload": "node scripts/pnpm.mjs --filter @storefront/web e2e upload",
    "e2e:env": "node scripts/pnpm.mjs --filter @storefront/web e2e:env",
    "lighthouse": "node scripts/pnpm.mjs --filter @storefront/web e2e performance",
    "security:zap": "node scripts/pnpm.mjs --filter @storefront/web e2e zap",
    "build": "node scripts/pnpm.mjs --workspace-concurrency=1 -r build",
    "seed": "node scripts/pnpm.mjs --filter @storefront/shared build && node scripts/pnpm.mjs --filter @storefront/api seed",
    "import:products": "node scripts/pnpm.mjs --filter @storefront/shared build && node scripts/pnpm.mjs --filter @storefront/api import:products",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:indexes": "node scripts/pnpm.mjs --filter @storefront/api db:indexes",
    "rehearse:api": "node scripts/rehearse-api.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "26.6.5",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "node": "26.12.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
